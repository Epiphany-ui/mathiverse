# Public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only credentials
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GENERATION_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Server-side Manim renderer
RENDERER_URL=http://127.0.0.1:9876
# Browser-side renderer proxy target (used by /api/render and the sandbox)
NEXT_PUBLIC_RENDERER_URL=http://localhost:9876

# AI code generation (DeepSeek, OpenAI-compatible). Required for AI features.
DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: local Ollama embeddings for RAG during generation
# OLLAMA_URL=http://localhost:11434
# EMBED_MODEL=bge-m3

# Optional: wiki entry ingest API token (POST /api/admin/wiki/ingest)
# WIKI_ADMIN_TOKEN=your_wiki_admin_token
